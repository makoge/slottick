generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Business {
  id                      String                   @id @default(cuid())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  name                    String
  slug                    String                   @unique
  city                    String
  country                 String
  website                 String?
  ownerEmail              String                   @unique
  passwordHash            String
  emailVerifiedAt         DateTime?
  failedLoginCount        Int                      @default(0)
  lockUntil               DateTime?
  marketplaceEligibleAt   DateTime?

  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?

  stripeCustomerId        String?                  @unique
  stripeSubscriptionId    String?                  @unique
  subscriptionStatus      String                   @default("trialing")

  logoUrl                 String?
  heroTag                 String?
  ratingAvg               Float?                   @default(0)
  ratingCount             Int?                     @default(0)
  industry                Industry
  postalCode              String?
  street                  String?
  description             String?
  availabilityRule        AvailabilityRule?
  bookings                Booking[]
  galleryImages           BusinessImage[]
  emailVerificationTokens EmailVerificationToken[]
  resetTokens             PasswordResetToken[]
  reviews                 Review[]
  services                Service[]
  sessions                Session[]
  profitCalculatorPreset  ProfitCalculatorPreset?
  automations             Automation[]
  scheduledMessages       ScheduledMessage[]
  marketingWorkspace      MarketingWorkspace?

  @@index([industry])
  @@index([city])
  @@index([country])
}

model Service {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  businessId     String
  name           String
  durationMin    Int
  price          Int
  currency       String
  depositEnabled Boolean         @default(false)
  depositType    String          @default("PERCENT")
  depositValue   Int?
  category       ServiceCategory @default(OTHER)
  bookings       Booking[]
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  images         ServiceImage[]

  @@index([businessId])
  @@index([category])
  @@index([businessId, category])
}

model AvailabilityRule {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  businessId  String   @unique
  timezone    String
  daysJson    String
  start       String
  end         String
  breakStart  String?
  breakEnd    String?
  bufferMin   Int
  slotStepMin Int
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  url        String
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, sort])
}

model Booking {
  id                String           @id @default(cuid())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  businessId        String
  serviceName       String
  durationMin       Int
  price             Int
  currency          String
  startsAt          DateTime
  customerName      String
  customerPhone     String
  customerEmail     String?
  notes             String?
  status            BookingStatus    @default(CONFIRMED)
  cancelledAt       DateTime?
  reviewEmailSentAt DateTime?
  reviewTokenHash   String?
  customerCountry   String?
  serviceCategory   ServiceCategory?
  serviceId         String?
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service           Service?         @relation(fields: [serviceId], references: [id])
  review            Review?

  @@unique([businessId, startsAt])
  @@index([businessId, startsAt])
  @@index([businessId, serviceId])
  @@index([businessId, serviceCategory])
}

model Review {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  businessId String
  bookingId  String   @unique
  rating     Int
  comment    String?
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Session {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  tokenHash  String   @unique
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  tokenHash  String    @unique
  usedAt     DateTime?
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  tokenHash  String    @unique
  usedAt     DateTime?
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([expiresAt])
}

model Customer {
  id           String            @id @default(cuid())
  createdAt    DateTime          @default(now())
  email        String            @unique
  passwordHash String
  name         String?
  phone        String?
  sessions     CustomerSession[]
}

model CustomerSession {
  tokenHash  String   @id
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  DONE
}

enum Industry {
  BEAUTY_AND_CARE
  WELLNESS_AND_LIFESTYLE
  CREATIVE_SERVICES
  HOME_AND_LOCAL
  EDUCATION_AND_PROFESSIONALS
}

enum ServiceCategory {
  LASH
  NAILS
  BROWS
  HAIR
  BARBER
  MASSAGE
  MAKEUP
  SKINCARE
  TATTOO
  FITNESS
  OTHER
}

model ProfitCalculatorPreset {
  businessId    String @id
  currency      String @default("EUR")
  price         Float  @default(0)
  minutes       Int    @default(60)
  feePct        Float  @default(0)
  taxPct        Float  @default(0)
  fixedMonthly  Float  @default(0)
  apptsPerMonth Int    @default(0)
  targetHourly  Float  @default(0)
  productsJson  String @default("[]")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingWorkspace {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // optional later: userId (if auth), or anonymousKey
  name String?

  businessId String?   @unique
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  messages ScheduledMessage[]
}

model ScheduledMessage {
  id           String  @id @default(cuid())
  businessId   String
  automationId String?
  workspaceId  String

  channel String // "email" (later: "whatsapp", "sms")
  to      String
  replyTo String?
  subject String
  html    String

  sendAt            DateTime
  status            String   @default("scheduled") // scheduled | sending | sent | failed | cancelled
  attempts          Int      @default(0)
  lastError         String?
  dedupeKey         String?  @unique
  providerMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  automation Automation?        @relation(fields: [automationId], references: [id], onDelete: SetNull)
  workspace  MarketingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([businessId])
  @@index([workspaceId, createdAt])
}

model Automation {
  id         String @id @default(cuid())
  businessId String
  name       String

  triggerJson  String
  templateJson String
  audienceJson String

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  messages ScheduledMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([isActive, nextRunAt])
}
