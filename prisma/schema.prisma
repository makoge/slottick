generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ==========================================
// BUSINESS & CORE PROFILE
// ==========================================

model Business {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  name                  String
  slug                  String    @unique
  city                  String
  country               String
  website               String?
  ownerEmail            String    @unique
  passwordHash          String
  emailVerifiedAt       DateTime?
  failedLoginCount      Int       @default(0)
  lockUntil             DateTime?
  marketplaceEligibleAt DateTime?

  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?

  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  billingProvider      BillingProvider?

  logoUrl      String?
  heroTag      String?
  ratingAvg    Float?   @default(0)
  ratingCount  Int?     @default(0)
  industry     Industry
  postalCode   String?
  street       String?
  description  String?

  bookingApprovalRequired Boolean @default(false)

  // Mobile Money direct billing
  momoPhone              String?
  momoNetwork            MobileNetwork?
  momoSubscriptionStatus MomoSubscriptionStatus?
  momoNextBillingDate    DateTime?
  momoLastPaidAt         DateTime?
  momoProviderRef        String?
  momoPlanCode           String?

  // Relations
  availabilityRules       AvailabilityRule[]
  staff                   Staff[]
  staffTimeOff            StaffTimeOff[]
  services                Service[]
  bookings                Booking[]
  customerProfiles        BusinessCustomerProfile[]
  slotHolds               SlotHold[]
  galleryImages           BusinessImage[]
  reviews                 Review[]
  sessions                Session[]
  resetTokens             PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  profitCalculatorPreset  ProfitCalculatorPreset?
  automations             Automation[]
  scheduledMessages       ScheduledMessage[]
  marketingWorkspace      MarketingWorkspace?
  bookingConversations    BookingConversation[]
  bookingMessages         BookingMessage[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  momoPaymentAttempts     MomoPaymentAttempt[]

  @@index([industry])
  @@index([city])
  @@index([country])
}

// ==========================================
// TEAM / STAFF & AVAILABILITY ENGINE
// ==========================================

model Staff {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  title       String?  // e.g. "Master Barber", "Colorist", "Chair 2"
  avatarUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  availabilityRules AvailabilityRule[]
  timeOff           StaffTimeOff[]
  services          Service[]
  bookings          Booking[]
  slotHolds         SlotHold[]

  @@index([businessId])
  @@index([isActive])
}

model AvailabilityRule {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  businessId  String
  staffId     String?  // If null: fallback business schedule; if set: overrides for this staff member

  timezone    String   @default("UTC")
  daysJson    String   // e.g. ["mon","tue","wed","thu","fri"]
  start       String   // "09:00"
  end         String   // "18:00"
  breakStart  String?  // "13:00"
  breakEnd    String?  // "14:00"
  bufferMin   Int      @default(0)
  slotStepMin Int      @default(15)

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([staffId])
}

model StaffTimeOff {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  businessId String
  staffId    String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
  @@index([staffId, startsAt, endsAt])
}

// ==========================================
// SERVICES & PRICING
// ==========================================

model Service {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  businessId     String
  name           String
  durationMin    Int
  price          Int
  currency       String          @default("EUR")
  category       ServiceCategory @default(OTHER)

  depositEnabled Boolean         @default(false)
  depositType    String          @default("PERCENT") // "PERCENT" | "AMOUNT"
  depositValue   Int?

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff          Staff[]
  images         ServiceImage[]
  bookingItems   BookingItem[]
  bookings       Booking[]       // Primary service relationship

  @@index([businessId])
  @@index([category])
  @@index([businessId, category])
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([serviceId, sort])
}

model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  url        String
  sort       Int      @default(0)
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, sort])
}

// ==========================================
// BOOKINGS, ITEMS & CONCURRENCY HOLDS
// ==========================================

model Booking {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessId        String
  staffId           String?
  serviceId         String?         // Primary service ID (optional backward compatibility)
  customerId        String?         // Linked client account if authenticated

  serviceName       String
  durationMin       Int
  price             Int
  currency          String

  startsAt          DateTime
  endsAt            DateTime

  customerName      String
  customerPhone     String
  customerEmail     String?
  customerCountry   String?
  notes             String?

  status            BookingStatus   @default(CONFIRMED)
  statusUpdatedAt   DateTime?
  respondedAt       DateTime?
  cancelledAt       DateTime?

  // Deposit & Payment Ledger
  depositPaid       Boolean         @default(false)
  depositAmount     Int?
  depositPaymentRef String?
  paymentStatus     PaymentStatus   @default(UNPAID)

  reviewEmailSentAt DateTime?
  reviewTokenHash   String?
  serviceCategory   ServiceCategory?

  // Relations
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff             Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  service           Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items             BookingItem[]
  review            Review?
  conversation      BookingConversation?
  notifications     Notification[]

  // Parallel bookings across different staff/chairs allowed
  @@unique([staffId, startsAt])
  @@index([businessId, startsAt, endsAt])
  @@index([staffId, startsAt, endsAt])
  @@index([businessId, status])
  @@index([customerId])
  @@index([customerPhone])
}

model BookingItem {
  id          String   @id @default(cuid())
  bookingId   String
  serviceId   String
  serviceName String
  durationMin Int
  price       Int

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([serviceId])
}

model SlotHold {
  id         String   @id @default(cuid())
  businessId String
  staffId    String?
  sessionId  String
  startsAt   DateTime
  endsAt     DateTime
  expiresAt  DateTime // Temporary lock release timestamp (e.g., 10 minutes)
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt, endsAt])
  @@index([staffId, startsAt, endsAt])
  @@index([expiresAt])
}

// ==========================================
// CLIENT CRM & CUSTOMER ACCOUNTS
// ==========================================

model Customer {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  email          String    @unique
  passwordHash   String?
  name           String?
  phone          String?
  image          String?
  authProvider   String?   // "credentials" | "google" | "apple"
  authProviderId String?

  sessions             CustomerSession[]
  bookings             Booking[]
  businessProfiles     BusinessCustomerProfile[]
  bookingConversations BookingConversation[]
  bookingMessages      BookingMessage[]

  @@index([authProvider])
  @@index([authProviderId])
}

model BusinessCustomerProfile {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  businessId  String
  customerId  String?
  name        String
  phone       String
  email       String?
  notes       String?   // Private internal notes (e.g. guard sizes, color formulas)
  isBlocked   Boolean   @default(false)
  noShowCount Int       @default(0)
  totalVisits Int       @default(0)

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([customerId])
}

model CustomerSession {
  tokenHash  String   @id
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  customerId String

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

// ==========================================
// REVIEWS & CHAT / MESSAGING
// ==========================================

model Review {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  businessId String
  bookingId  String   @unique
  rating     Int
  comment    String?

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BookingConversation {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookingId       String           @unique
  businessId      String
  customerId      String?
  clientTokenHash String?          @unique
  lastMessageAt   DateTime?
  closedAt        DateTime?

  booking         Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages        BookingMessage[]

  @@index([businessId, updatedAt])
  @@index([customerId])
}

model BookingMessage {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  conversationId String
  senderType     MessageSenderType
  businessId     String?
  customerId     String?
  body           String
  isRead         Boolean           @default(false)

  conversation   BookingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  business       Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([isRead])
  @@index([businessId])
  @@index([customerId])
}

// ==========================================
// NOTIFICATIONS & PUSH ALERTS
// ==========================================

model Notification {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  businessId String
  bookingId  String?
  type       String
  title      String
  body       String?
  isRead     Boolean  @default(false)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([businessId, isRead, createdAt])
  @@index([bookingId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  businessId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ==========================================
// MARKETING & AUTOMATIONS
// ==========================================

model MarketingWorkspace {
  id         String             @id @default(cuid())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  name       String?
  businessId String?            @unique

  business   Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages   ScheduledMessage[]
}

model ScheduledMessage {
  id                String              @id @default(cuid())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  businessId        String
  automationId      String?
  workspaceId       String

  channel           String              // "email" | "whatsapp" | "sms"
  to                String
  replyTo           String?
  subject           String
  html              String
  sendAt            DateTime
  status            String              @default("scheduled")
  attempts          Int                 @default(0)
  lastError         String?
  dedupeKey         String?             @unique
  providerMessageId String?

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  automation        Automation?         @relation(fields: [automationId], references: [id], onDelete: SetNull)
  workspace         MarketingWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([businessId])
  @@index([workspaceId, createdAt])
}

model Automation {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  businessId   String
  name         String
  triggerJson  String
  templateJson String
  audienceJson String
  isActive     Boolean            @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?

  messages     ScheduledMessage[]
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([isActive, nextRunAt])
}

// ==========================================
// AUTH & UTILITIES
// ==========================================

model Session {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  tokenHash  String   @unique
  businessId String

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  tokenHash  String    @unique
  usedAt     DateTime?
  businessId String

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  tokenHash  String    @unique
  usedAt     DateTime?
  businessId String

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([expiresAt])
}

model ProfitCalculatorPreset {
  businessId    String   @id
  currency      String   @default("EUR")
  price         Float    @default(0)
  minutes       Int      @default(60)
  feePct        Float    @default(0)
  taxPct        Float    @default(0)
  fixedMonthly  Float    @default(0)
  apptsPerMonth Int      @default(0)
  targetHourly  Float    @default(0)
  productsJson  String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ==========================================
// MOBILE MONEY BILLING
// ==========================================

model MomoPaymentAttempt {
  id                String              @id @default(cuid())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  businessId        String
  provider          MobileMoneyProvider
  phoneNumber       String
  network           MobileNetwork
  amount            Int
  currency          String              @default("XAF")
  billingForMonth   String?
  externalReference String              @unique
  providerTxnId     String?
  status            MomoPaymentStatus   @default(PENDING)
  initiatedAt       DateTime?
  completedAt       DateTime?
  expiresAt         DateTime?
  failureCode       String?
  failureReason     String?
  rawResponseJson   String?

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@index([provider, externalReference])
}

model MomoWebhookEvent {
  id           String              @id @default(cuid())
  createdAt    DateTime            @default(now())
  provider     MobileMoneyProvider
  eventType    String?
  eventId      String?
  reference    String?
  payloadJson  String
  processedAt  DateTime?
  status       String              @default("received")
  errorMessage String?

  @@index([provider, createdAt])
  @@index([eventId])
  @@index([reference])
}

// ==========================================
// ENUMS
// ==========================================

enum BookingStatus {
  PENDING
  NEEDS_INFO
  CONFIRMED
  DECLINED
  CANCELLED
  DONE
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  FULLY_PAID
  REFUNDED
}

enum Industry {
  BEAUTY_AND_CARE
  WELLNESS_AND_LIFESTYLE
  CREATIVE_SERVICES
  HOME_AND_LOCAL
  EDUCATION_AND_PROFESSIONALS
}

enum ServiceCategory {
  LASH
  NAILS
  BROWS
  HAIR
  BARBER
  MASSAGE
  MAKEUP
  SKINCARE
  TATTOO
  FITNESS
  OTHER
}

enum MessageSenderType {
  BUSINESS
  CUSTOMER
  SYSTEM
}

enum MobileNetwork {
  MTN
  ORANGE
}

enum MobileMoneyProvider {
  MTN_MOMO
  ORANGE_MONEY
}

enum MomoSubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  PAST_DUE
  CANCELED
}

enum MomoPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  FAILED
  CANCELED
  INACTIVE
}

enum BillingProvider {
  STRIPE
  MTN_MOMO
  ORANGE_MONEY
}
